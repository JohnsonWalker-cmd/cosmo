# MongoDB Atlas connection string. Atlas dashboard -> Connect -> Drivers.
MONGODB_URI=

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where the React frontend runs, for CORS. Vite's default dev port.
CLIENT_ORIGIN=http://localhost:5173

PORT=4000
NODE_ENV=development

